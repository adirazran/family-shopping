rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== רשימת קניות (family-shopping) — ללא שינוי =====
    // הודעות בשיחה: כל מי שיש לו את הקישור יכול לקרוא ולכתוב
    match /messages/{id} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() < 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['added']);
      allow delete: if false;
    }
    // פריטים ברשימה
    match /items/{id} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() < 200;
      allow update, delete: if true;
    }

    // אווטאר של כל משתתף ברשימת הקניות
    match /profiles/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['emoji', 'bday'])
                   && (!('emoji' in request.resource.data) || (request.resource.data.emoji is string && request.resource.data.emoji.size() < 16))
                   && (!('bday' in request.resource.data) || (request.resource.data.bday is string && request.resource.data.bday.matches('^[0-9]{2}-[0-9]{2}$')));
    }
    // "אני בסופר" – מי בסופר עכשיו
    match /status/{id} {
      allow read: if true;
      allow write: if id == 'shopping'
                   && request.resource.data.keys().hasOnly(['who', 'since'])
                   && request.resource.data.who is string && request.resource.data.who.size() < 20
                   && request.resource.data.since is number;
    }

    // ===== תוכנת הוצאות למשפחה (family-expenses) =====
    // לכל ילד מפתח סודי משלו בקישור. רק מי שמחזיק את הקישור רואה את הגיליון.
    // אי אפשר לקבל רשימה של כל הגיליונות (אין כלל ל-/fx/{key} עצמו).
    function validKey(key) {
      return key.size() >= 20 && key.size() <= 64;
    }
    match /fx/{key}/expenses/{id} {
      allow get, list: if validKey(key);
      allow create, update: if validKey(key)
        && request.resource.data.keys().hasOnly(['amount', 'note', 'date', 'createdAt'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if validKey(key);
    }
    match /fx/{key}/settings/{id} {
      allow get, list: if validKey(key);
      allow write: if validKey(key)
        && ((id == 'budget'
              && request.resource.data.keys().hasOnly(['amount'])
              && request.resource.data.amount is number
              && request.resource.data.amount >= 0
              && request.resource.data.amount < 10000000)
         || (id == 'meta'
              && request.resource.data.keys().hasOnly(['name', 'title'])
              && request.resource.data.name is string
              && request.resource.data.name.size() <= 40
              && request.resource.data.title is string
              && request.resource.data.title.size() <= 60));
    }
  }
}
